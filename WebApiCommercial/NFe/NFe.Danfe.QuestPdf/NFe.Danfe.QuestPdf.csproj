<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Fontes\Arial.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embutida no assembly, e SÓ embutida: sem CopyToOutputDirectory.
         O publish é único para toda a solução e MDFe.Damdfe.QuestPdf embute o
         mesmo Fontes\Arial.ttf; as duas cópias caíam no mesmo caminho relativo
         e quebravam o publish com NETSDK1152. Nada lê o .ttf do disco — a
         fonte viaja dentro do assembly. -->
    <EmbeddedResource Include="Fontes\Arial.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BarcodeLib" Version="3.1.4" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
    <PackageReference Include="QuestPDF" Version="2024.7.3" />
    <!--<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />-->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!--<PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.QrCode" Version="0.7.0" />-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DFe.Classes\DFe.Classes.csproj" />
    <ProjectReference Include="..\DFe.Utils\DFe.Utils.csproj" />
    <ProjectReference Include="..\NFe.Classes\NFe.Classes.csproj" />
    <ProjectReference Include="..\NFe.Danfe.Base\NFe.Danfe.Base.csproj" />
    <ProjectReference Include="..\NFe.Utils\NFe.Utils.csproj" />
  </ItemGroup>

</Project>
